# ============================================================
# Required for both local dev and production
# ============================================================

# --- Auth.js (next-auth v5) ---
# Random secret used to sign JWT session cookies.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# OAuth client credentials from Google Cloud Console
# (APIs & Services → Credentials → OAuth client ID, type "Web application").
#
# Authorized redirect URIs to configure:
#   Local dev:    http://localhost:3000/api/auth/callback/google
#   Production:   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Picker (client-side, Phase 2) ---
# API key created in the same Cloud project. Public — safe to expose
# to the browser.
#
# Restrict it in the Cloud Console:
#   Application restrictions: HTTP referrers
#     Local dev:    http://localhost:3000/*
#     Production:   https://<your-domain>/*
#   API restrictions: Google Picker API (and Drive API if you want
#     client-side Drive calls later).
NEXT_PUBLIC_GOOGLE_API_KEY=

# Reserved for future Google Identity Services usage. Leave empty unless
# you wire up an additional client-side OAuth flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ============================================================
# Production only
# ============================================================

# Auth.js v5 refuses to trust the request `Host` header by default. On
# managed hosts (Vercel, Render, Railway, Fly, etc.) that terminate TLS
# upstream and pass the public host through, this must be set to `true`
# or Auth.js returns "UntrustedHost" errors.
#
# Vercel auto-detects via VERCEL_URL, but setting this explicitly is the
# safest default for any deploy target.
AUTH_TRUST_HOST=true

# Optional. Only needed when AUTH_TRUST_HOST isn't enough — e.g. you're
# behind a reverse proxy that rewrites Host. Set to the full public URL
# the app is served from (no trailing slash).
# AUTH_URL=https://your-domain.example.com
