{
  "name": "sidestage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:db": "node --import tsx --test --test-concurrency=1 scripts/tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "s3:init": "node --env-file=.env.local scripts/s3-init.mjs",
    "r2:backfill": "node --env-file=.env.local scripts/r2-backfill.mjs",
    "r2:sweep": "node --env-file=.env.local scripts/r2-sweep.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@serwist/next": "^9.5.12",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^144.0.0",
    "howler": "^2.2.4",
    "music-metadata": "^11.13.0",
    "next": "^15.5.18",
    "next-auth": "5.0.0-beta.25",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "serwist": "^9.5.12",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
